# The repository is ~15 MB, so the context is not worth trimming aggressively.
# CMakeLists.txt declares some test targets outside the BUILD_TESTING guard, so
# hiding sources/ here breaks `cmake -S .` even with -DBUILD_TESTING=OFF.
# Exclude only host build residue; keep the tree faithful.
.git
.gitignore
.gitattributes
build/
build*/
bin/
.venv/
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.log
*.egg-info/
.pytest_cache/
.ccache/
.vscode/
.idea/
